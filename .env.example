# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Grafana admin password (defaults to "admin" for local-only use if unset)
GF_ADMIN_PASSWORD=admin

# PostgreSQL password for the /ask journal (user "facade", db "asklog";
# defaults to "facade" for local-only use if unset)
PG_PASSWORD=facade

# vLLM model weights cache on the host (bind-mounted into the `vllm` service);
# defaults to ~/vllm-hf-cache if unset
# VLLM_HF_CACHE=~/vllm-hf-cache

# Where the facade sends generation; defaults to the `vllm` compose service
# VLLM_BASE=http://vllm:8000/v1

# GigaChat API authorization key — only for the model comparison in eval/regen.py
# (developers.sber.ru -> GigaChat API -> project -> "Authorization key").
# The assistant itself never calls external services.
GIGACHAT_AUTH_KEY=
